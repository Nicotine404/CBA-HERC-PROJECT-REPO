  <script>
    const cosmoFaces = {
      happy: { label: 'Feliz', svg: '<path d="M33 38 L38 33 L43 38" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M57 38 L62 33 L67 38" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M43 45 Q50 51 57 45" fill="none" stroke="#FDBA74" stroke-width="2.5" stroke-linecap="round"/>' },
      excited: { label: 'Emocionado', svg: '<polygon points="38,30 40,35 45,35 41,38 42,43 38,40 34,43 35,38 31,35 36,35" fill="#FCD34D"/><polygon points="62,30 64,35 69,35 65,38 66,43 62,40 58,43 59,38 55,35 60,35" fill="#FCD34D"/><path d="M42 45 Q50 53 58 45 Z" fill="#FE6F3F"/>' },
      thinking: { label: 'Curioso', svg: '<circle cx="38" cy="36" r="4.5" fill="none" stroke="#FFFFFF" stroke-width="2.5"/><circle cx="62" cy="34" r="3" fill="#FFFFFF"/><path d="M44 46 Q50 44 56 47" fill="none" stroke="#93C5FD" stroke-width="2.5" stroke-linecap="round"/><text x="68" y="30" fill="#FCD34D" font-size="10" font-family="monospace" font-weight="bold">?</text>' },
      surprised: { label: 'Asombrado', svg: '<path d="M32 37 L37 32 L42 37 L37 42 Z" fill="none" stroke="#FFFFFF" stroke-width="2.5"/><path d="M58 37 L63 32 L68 37 L63 42 Z" fill="none" stroke="#FFFFFF" stroke-width="2.5"/><circle cx="50" cy="47" r="3" fill="#FDBA74"/>' },
      proud: { label: 'Orgulloso', svg: '<rect x="31" y="33" width="16" height="9" rx="2.5" fill="#38BDF8" stroke="#FFFFFF" stroke-width="1.8"/><rect x="53" y="33" width="16" height="9" rx="2.5" fill="#38BDF8" stroke="#FFFFFF" stroke-width="1.8"/><line x1="47" y1="37" x2="53" y2="37" stroke="#FFFFFF" stroke-width="2"/><path d="M43 46 Q50 50 57 45" fill="none" stroke="#FCD34D" stroke-width="2.5" stroke-linecap="round"/>' },
      encouraging: { label: 'Ánimo', svg: '<circle cx="38" cy="37" r="3.5" fill="#FFFFFF"/><circle cx="62" cy="37" r="3.5" fill="#FFFFFF"/><path d="M44 46 Q50 49 56 46" fill="none" stroke="#6EE7B7" stroke-width="2.5" stroke-linecap="round"/>' }
    };

    const mascotTips = [
      ['COSMO · STEM', '¡Soy Cosmo! Elegí una materia arriba y te cuento cómo la aprendimos.', 'thinking'],
      ['COSMO · SIN RED', 'Todas las fichas tienen alternativa impresa para trabajar sin conexión.', 'happy'],
      ['COSMO · CONSEJO', 'Contrastá siempre las respuestas de IA con mediciones reales en clase.', 'encouraging'],
      ['COSMO · NASA', 'Katherine Johnson verificaba a mano las trayectorias antes de cada vuelo.', 'proud']
    ];
    let mascotIdx = 0;
    function mascotSay(tag, text, mood) {
      const f = cosmoFaces[mood] || cosmoFaces.happy;
      const t = document.getElementById('mascot-tag');
      const m = document.getElementById('mascot-text');
      const pEl = document.getElementById('mascot-mood-pill');
      const faceEl = document.getElementById('cosmo-face');
      if (t) t.textContent = tag;
      if (m) m.textContent = text;
      if (pEl) pEl.textContent = f.label;
      if (faceEl) faceEl.innerHTML = f.svg;
    }
    function nextMascotTip() {
      mascotIdx = (mascotIdx + 1) % mascotTips.length;
      mascotSay(mascotTips[mascotIdx][0], mascotTips[mascotIdx][1], mascotTips[mascotIdx][2]);
    }
    mascotSay(mascotTips[0][0], mascotTips[0][1], mascotTips[0][2]);
    const subjectData = {
      fisica: { badge: 'FÍSICA · 4.º SECUNDARIA · 45 MIN', title: 'Medir la rapidez con un carrito escolar', desc: 'Tres estudiantes cronometran el mismo carrito y comparan por qué sus mediciones difieren antes de contrastarlo con los cálculos verificables de Katherine Johnson en la NASA.', nasa: 'Katherine Johnson · Verificación de trayectorias antes de lanzar.' },
      mate: { badge: 'MATEMÁTICAS · 3.º SECUNDARIA · 40 MIN', title: 'Más allá de los números en una cuadrícula', desc: 'Comparar dos rutas posibles, calcular distancias y defender una elección con números y un dibujo frente al grupo.', nasa: 'Modelos matemáticos de trayectoria de vuelo NASA.' },
      robotica: { badge: 'ROBÓTICA · 5.º SECUNDARIA · 50 MIN', title: 'Trazar una ruta autónoma entre obstáculos', desc: 'Explicar qué sensores e información necesita un vehículo para decidir por dónde avanzar sin intervención humana.', nasa: 'AutoNav · Sistema de navegación autónoma del rover Perseverance.' },
      quimica: { badge: 'QUÍMICA · 4.º SECUNDARIA · 45 MIN', title: 'La ciencia detrás de filtrar y recuperar agua', desc: 'Comparar mezclas de agua con arena y sal para predecir qué separa un filtro sencillo frente a sistemas cerrados.', nasa: 'Centro Espacial Johnson · Sistemas de soporte vital y recuperación de agua.' },
      astro: { badge: 'ASTRONOMÍA · 6.º SECUNDARIA · 45 MIN', title: 'De la Tierra a otros planetas: ventanas de lanzamiento', desc: 'Comparar órbitas en un esquema e identificar por qué importan el movimiento planetario y el momento de partida.', nasa: 'Misión Mars 2020 · Viaje interplanetario, aterrizaje y rover.' }
    };
    function selectSubject(key, btn) {
      const subjTips = {
        fisica: ['COSMO · FÍSICA', 'Si 3 alumnos cronometran el mismo carrito, ¡casi nunca da igual! De ahí nace la ciencia.', 'surprised'],
        mate: ['COSMO · MATE', 'Comparar rutas en cuadrícula ayuda a entender modelos matemáticos de vuelo.', 'thinking'],
        robotica: ['COSMO · ROBÓTICA', 'AutoNav permite al rover Perseverance esquivar rocas en Marte por sí solo.', 'excited'],
        quimica: ['COSMO · QUÍMICA', 'En la NASA reciclan más del 90% del agua a bordo del soporte vital.', 'surprised'],
        astro: ['COSMO · ASTRO', 'La posición de la Tierra y Marte define cuándo conviene lanzar una misión.', 'proud']
      };
      if (subjTips[key]) mascotSay(subjTips[key][0], subjTips[key][1], subjTips[key][2]);
      const d = subjectData[key]; if (!d) return;
      document.getElementById('subj-badge').textContent = d.badge;
      document.getElementById('subj-title').textContent = d.title;
      document.getElementById('subj-desc').textContent = d.desc;
      document.getElementById('subj-nasa').textContent = d.nasa;
      document.querySelectorAll('.subj-btn').forEach((b) => {
        b.className = 'subj-btn px-4 py-1.5 rounded-full font-mono text-label-sm bg-warm-card border border-warm-border text-azul-noche hover:border-azul-noche transition-colors';
      });
      if (btn) btn.className = 'subj-btn px-4 py-1.5 rounded-full font-mono text-label-sm bg-azul-noche text-white transition-colors';
    }
    const translations = {
      es: {
        nav_home: "Inicio", nav_activities: "Actividades", nav_stem: "Áreas STEM", nav_library: "Recursos", nav_herc: "HERC", nav_team: "Equipo", nav_visits: "Visitas",
        stem_title: "Aprendizaje basado en experiencias", stem_link1: "Explorar ficha imprimible", stem2_desc: "Pregunta inicial, práctica en equipos con materiales escolares accesibles y cierre guiado. Listo para leer en celular o imprimir.", stem_link2: "Ver materiales sugeridos",
        stem3_desc: "Planificá clases y contrastá respuestas de IA con mediciones reales del curso. Incluye alternativa impresa sin conexión.", stem_link3: "Ver charlas y talleres",
        banner_title: "Sumá tu experiencia", banner_desc: "Compartí tu práctica, adaptación o recurso para que más escuelas puedan implementarlo.", banner_cta: "Enviar un aporte"
      },
      en: {
        nav_home: "Home", nav_activities: "Activities", nav_stem: "STEM Areas", nav_library: "Resources", nav_herc: "HERC", nav_team: "Team", nav_visits: "Visits",
        stem_title: "Experience-based STEM learning", stem_link1: "Explore printable guide", stem2_desc: "Opening question, team practice with accessible school materials, and guided wrap-up. Mobile and print ready.", stem_link2: "View suggested materials",
        stem3_desc: "Plan lessons and contrast AI responses with real classroom measurements. Includes an offline print alternative.", stem_link3: "View talks & workshops",
        banner_title: "Share your experience", banner_desc: "Share your classroom practice or resource so more schools can adapt it.", banner_cta: "Submit entry"
      }
    };
    function setLang(lang) {
      mascotSay('COSMO · IDIOMA', lang === 'en' ? 'Switched to English! Pick any STEM subject above.' : '¡Cambiado a español! Elegí cualquier materia arriba.', 'happy');
      document.documentElement.lang = lang;
      const dict = translations[lang] || translations.es;
      document.querySelectorAll('[data-i18n]').forEach((el) => { const k = el.getAttribute('data-i18n'); if (dict[k]) el.textContent = dict[k]; });
      document.querySelectorAll('.lang-es-btn').forEach((b) => { b.className = lang === 'es' ? 'lang-es-btn px-3 py-1 rounded-full font-mono text-label-sm bg-azul-noche text-white transition-colors' : 'lang-es-btn px-3 py-1 rounded-full font-mono text-label-sm text-azul-noche/70 hover:text-azul-noche transition-colors'; });
      document.querySelectorAll('.lang-en-btn').forEach((b) => { b.className = lang === 'en' ? 'lang-en-btn px-3 py-1 rounded-full font-mono text-label-sm bg-azul-noche text-white transition-colors' : 'lang-en-btn px-3 py-1 rounded-full font-mono text-label-sm text-azul-noche/70 hover:text-azul-noche transition-colors'; });
    }
    function openShareModal() {
      mascotSay('COSMO · APORTE', 'Contanos qué material escolar usaste y cuánto tiempo tomó la actividad.', 'thinking');
      const m = document.getElementById('share-modal');
      document.getElementById('share-form').classList.remove('hidden');
      document.getElementById('share-receipt').classList.add('hidden');
      m.classList.remove('hidden'); m.classList.add('flex');
    }
    function closeShareModal() { const m = document.getElementById('share-modal'); m.classList.add('hidden'); m.classList.remove('flex'); }
    function submitShareForm(e) { e.preventDefault(); document.getElementById('share-form').classList.add('hidden'); document.getElementById('share-receipt').classList.remove('hidden'); }

    (function syncHeaderStella(){
      try {
        const raw = localStorage.getItem('cba_stella_profile_v1');
        if (raw) {
          const p = JSON.parse(raw);
          document.querySelectorAll('.header-stella-val').forEach((el) => { el.textContent = p.stellas ?? 250; });
