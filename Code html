      function resizeSolar() {
        const rect = layer.getBoundingClientRect();
        w = rect.width || 1600;
        h = rect.height || 900;
        canvas.width = w * dpr;
        canvas.height = h * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      }

      window.addEventListener('resize', resizeSolar);
      resizeSolar();

      let sunPulse = 0;

      function renderSolar() {
        ctx.clearRect(0, 0, w, h);
        const cx = w * 0.5;
        const cy = h * 0.5;
        const maxRadiusX = w * 0.45;
        const maxRadiusY = h * 0.43;

        sunBtn.style.left = '50%';
        sunBtn.style.top = '50%';

        // Full-screen wide-spaced orbits
        planets.forEach((p) => {
          const rx = maxRadiusX * p.orbitRatio;
          const ry = maxRadiusY * p.orbitRatio;
          ctx.save();
          ctx.strokeStyle = 'rgba(255, 255, 255, 0.14)';
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.ellipse(cx, cy, rx, ry, 0, 0, Math.PI * 2);
          ctx.stroke();
          ctx.restore();
        });

        // Planets + white orbital trails
        planets.forEach((p) => {
          if (!prefersReduced) {
            p.angle += p.speed;
          }

          const rx = maxRadiusX * p.orbitRatio;
          const ry = maxRadiusY * p.orbitRatio;

          // White comet trail along the full-screen orbit
          const trailSegments = 28;
          const trailArc = 0.45;
          for (let i = 0; i < trailSegments; i++) {
            const t0 = p.angle - (i / trailSegments) * trailArc;
            const t1 = p.angle - ((i + 1) / trailSegments) * trailArc;
            const alpha = (1 - i / trailSegments) * 0.72;

            ctx.strokeStyle = 'rgba(255, 255, 255, ' + alpha.toFixed(3) + ')';
            ctx.lineWidth = Math.max(0.6, (1 - i / trailSegments) * 2.0);
            ctx.lineCap = 'round';
            ctx.beginPath();
            ctx.moveTo(cx + Math.cos(t0) * rx, cy + Math.sin(t0) * ry);
            ctx.lineTo(cx + Math.cos(t1) * rx, cy + Math.sin(t1) * ry);
            ctx.stroke();
          }

          const px = cx + Math.cos(p.angle) * rx;
          const py = cy + Math.sin(p.angle) * ry;

          if (p.ring) {
            ctx.save();
            ctx.translate(px, py);
            ctx.rotate(-0.28);
            ctx.strokeStyle = 'rgba(255, 251, 235, 0.55)';
            ctx.lineWidth = 1.4;
            ctx.beginPath();
            ctx.ellipse(0, 0, p.radius * 1.75, p.radius * 0.46, 0, 0, Math.PI * 2);
            ctx.stroke();
            ctx.restore();
          }

          if (p.el && w > 0 && h > 0) {
            p.el.style.left = ((px / w) * 100).toFixed(4) + '%';
            p.el.style.top = ((py / h) * 100).toFixed(4) + '%';
          }
        });

        if (!prefersReduced) requestAnimationFrame(renderSolar);
      }

      renderSolar();
    })();
