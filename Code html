    // 1. Evenly Spaced Background Dots + Hover-Reactive Spiral Galaxies + Shooting Stars
    (function initSpaceCanvas() {
      const zone = document.getElementById('hero-starfield-zone');
      const canvas = document.getElementById('space-canvas');
      if (!zone || !canvas) return;
      const ctx = canvas.getContext('2d');
      const prefersReduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const starPalette = ['#FFFFFF', '#DCEBFF', '#93C5FD', '#FEF3C7', '#FDBA74', '#DDD6FE'];

      let width = 0;
      let height = 0;
      let dpr = Math.min(window.devicePixelRatio || 1, 2);
      const mouse = { x: -9999, y: -9999, active: false };
      const stars = [];
      const shootingStars = [];

      function drawFourPointStar(cx, cy, outerR, innerR, color, alpha) {
        ctx.save();
        ctx.globalAlpha = alpha;
        ctx.fillStyle = color;
        ctx.beginPath();
        for (let i = 0; i < 8; i++) {
          const angle = (i * Math.PI) / 4 - Math.PI / 2;
          const r = i % 2 === 0 ? outerR : innerR;
          const x = cx + Math.cos(angle) * r;
          const y = cy + Math.sin(angle) * r;
          if (i === 0) ctx.moveTo(x, y);
          else ctx.lineTo(x, y);
        }
        ctx.closePath();
        ctx.fill();
        ctx.restore();
      }

      function buildStarfield() {
        stars.length = 0;
        const rect = zone.getBoundingClientRect();
        width = rect.width || 1600;
        height = rect.height || 900;
        canvas.width = width * dpr;
        canvas.height = height * dpr;
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

        // Naturally scattered stars (jittered distribution so they feel organic, never a rigid grid)
        const cols = 22;
        const rows = 12;
        for (let r = 0; r < rows; r++) {
          for (let c = 0; c < cols; c++) {
            const isSparkle = Math.random() < 0.22;
            stars.push({
              x: ((c + 0.12 + Math.random() * 0.76) / cols) * width,
              y: ((r + 0.12 + Math.random() * 0.76) / rows) * height,
              baseSize: 0.7 + Math.random() * 1.25,
              color: starPalette[Math.floor(Math.random() * starPalette.length)],
              baseAlpha: 0.24 + Math.random() * 0.56,
              twinklePhase: Math.random() * Math.PI * 2,
              twinkleSpeed: 0.008 + Math.random() * 0.02,
              isSparkle: isSparkle,
              currentScale: 1
            });
          }
        }

        // 4 distant spiral galaxies in the outer corners that enlarge on mouse hover
        const galaxies = [
          { cx: width * 0.11, cy: height * 0.16, arms: 2, radius: 105, tilt: 0.45, count: 70 },
          { cx: width * 0.89, cy: height * 0.16, arms: 2, radius: 100, tilt: -0.4, count: 65 },
          { cx: width * 0.11, cy: height * 0.84, arms: 2, radius: 100, tilt: -0.35, count: 65 },
          { cx: width * 0.89, cy: height * 0.84, arms: 2, radius: 95, tilt: 0.4, count: 60 }
        ];

        galaxies.forEach((g) => {
          for (let i = 0; i < g.count; i++) {
            const arm = i % g.arms;
            const t = Math.pow(Math.random(), 0.78);
            const dist = t * g.radius;
            const angle = (arm * (Math.PI * 2 / g.arms)) + t * 3.5 + (Math.random() - 0.5) * 0.45;
            const gx = Math.cos(angle) * dist;
            const gy = Math.sin(angle) * dist * 0.52;
            const rotX = gx * Math.cos(g.tilt) - gy * Math.sin(g.tilt);
            const rotY = gx * Math.sin(g.tilt) + gy * Math.cos(g.tilt);

            stars.push({
              x: g.cx + rotX,
              y: g.cy + rotY,
              baseSize: 0.7 + (1 - t) * 0.55,
              color: starPalette[Math.floor(Math.random() * starPalette.length)],
              baseAlpha: 0.28 + (1 - t) * 0.32,
              twinklePhase: Math.random() * Math.PI * 2,
              twinkleSpeed: 0.014 + Math.random() * 0.018,
              currentScale: 1
            });
          }
        });
      }

      function spawnShootingStar() {
        const startX = width * (0.16 + Math.random() * 0.68);
        const startY = height * (0.05 + Math.random() * 0.25);
        const speed = 10 + Math.random() * 5;
        const angle = Math.PI * (0.68 + Math.random() * 0.16);
        shootingStars.push({
          x: startX,
          y: startY,
          vx: Math.cos(angle) * speed,
          vy: Math.sin(angle) * speed,
          len: 85 + Math.random() * 55,
          life: 1.0,
          decay: 0.025 + Math.random() * 0.015
        });
      }

      zone.addEventListener('mousemove', (e) => {
        const rect = zone.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;
      });
      zone.addEventListener('mouseleave', () => {
        mouse.active = false;
      });

      window.addEventListener('resize', buildStarfield);
      buildStarfield();

      setTimeout(spawnShootingStar, 400);
      if (!prefersReduced) {
        setInterval(() => {
          if (Math.random() < 0.75) spawnShootingStar();
        }, 3000);
      }

      function renderSpace() {
        ctx.clearRect(0, 0, width, height);
        const hoverRadius = 185;

        stars.forEach((s) => {
          s.twinklePhase += s.twinkleSpeed;
          const twinkle = 0.85 + Math.sin(s.twinklePhase) * 0.15;
          let targetScale = 1;
          let alpha = s.baseAlpha * twinkle;

          if (mouse.active) {
            const dist = Math.hypot(mouse.x - s.x, mouse.y - s.y);
            if (dist < hoverRadius) {
              const factor = 1 - dist / hoverRadius;
              targetScale = 1 + factor * 4.8;
              alpha = Math.min(1, alpha + factor * 0.75);
            }
          }
          s.currentScale += (targetScale - s.currentScale) * 0.18;

          if (s.isSparkle || s.currentScale > 1.8) {
            const outerR = s.baseSize * s.currentScale * 1.45;
            const innerR = outerR * 0.34;
            drawFourPointStar(s.x, s.y, outerR, innerR, s.color, alpha);
          } else {
            ctx.save();
            ctx.globalAlpha = alpha;
            ctx.fillStyle = s.color;
            ctx.beginPath();
            ctx.arc(s.x, s.y, s.baseSize * s.currentScale, 0, Math.PI * 2);
            ctx.fill();
            ctx.restore();
          }
        });

        for (let i = shootingStars.length - 1; i >= 0; i--) {
          const st = shootingStars[i];
          const tailX = st.x - (st.vx / Math.hypot(st.vx, st.vy)) * st.len;
          const tailY = st.y - (st.vy / Math.hypot(st.vx, st.vy)) * st.len;

          const grad = ctx.createLinearGradient(st.x, st.y, tailX, tailY);
          grad.addColorStop(0, 'rgba(255, 255, 255, ' + st.life.toFixed(2) + ')');
          grad.addColorStop(0.4, 'rgba(220, 235, 255, ' + (st.life * 0.45).toFixed(2) + ')');
          grad.addColorStop(1, 'rgba(0, 0, 0, 0)');

          ctx.strokeStyle = grad;
          ctx.lineWidth = 1.5;
          ctx.lineCap = 'round';
          ctx.beginPath();
          ctx.moveTo(st.x, st.y);
          ctx.lineTo(tailX, tailY);
          ctx.stroke();

          drawFourPointStar(st.x, st.y, 4 * st.life, 1.3 * st.life, '#FFFFFF', st.life);

          st.x += st.vx;
          st.y += st.vy;
          st.life -= st.decay;
          if (st.life <= 0) shootingStars.splice(i, 1);
        }

        if (!prefersReduced) requestAnimationFrame(renderSpace);
      }

      renderSpace();
    })();

