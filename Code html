        a.style.width = (p.radius * 2) + 'px';
        a.style.height = (p.radius * 2) + 'px';
        a.style.background = 'radial-gradient(circle at 32% 32%, ' + p.cream + ' 0%, ' + p.color + ' 60%, ' + p.color + ' 100%)';
        a.style.boxShadow = '0 0 0 8px ' + p.glow + ', 0 0 18px 3px ' + p.glow;
