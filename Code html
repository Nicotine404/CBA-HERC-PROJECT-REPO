        { id: 'visitas', label: 'Visitas', href: '../visitas/VisitasEscolares.html', orbitRatio: 1.00, speed: 0.0025, angle: 3.60, radius: 48, fontSize: '14.5px', cream: '#FFF1F2', color: '#FDA4AF', glow: 'rgba(244, 63, 94, 0.20)', ring: false }
