      },
      en: {
        nav_home: "Home", nav_activities: "Activities", nav_stem: "STEM Areas", nav_library: "Resources", nav_herc: "HERC", nav_team: "Team", nav_visits: "Visits",
        act_title: "2027 Calendar · Talks & STEM Fair", act_note: "5 Cine CBA sessions · 9 school visits",
        act2_title: "CBA STEM Fair", act2_desc: "Invited clubs showcase projects with quick teacher challenges, live NASA HERC rover demos, and printable guides.",
        act1_title: "Scientist for a Day · Open NASA Data", act1_desc: "Formulate questions, predict outcomes, and compare them against real observations.",
        act3_title: "Beyond ChatGPT & AutoNav", act3_desc: "Compare Perseverance obstacle autonomy with generative AI assistants.",
        act_register: "Register", banner_title: "Share your experience", banner_desc: "Share your classroom practice or resource so more schools can adapt it.", banner_cta: "Submit entry"
      }
    };
    function setLang(lang) {
      mascotSay('COSMO · IDIOMA', lang === 'en' ? 'Switched to English! Click me anytime for STEM tips.' : '¡Idioma cambiado a español! Tocame cuando quieras otro dato.', 'happy');
      document.documentElement.lang = lang;
      const dict = translations[lang] || translations.es;
      document.querySelectorAll('[data-i18n]').forEach((el) => { const k = el.getAttribute('data-i18n'); if (dict[k]) el.textContent = dict[k]; });
      document.querySelectorAll('.lang-es-btn').forEach((b) => { b.className = lang === 'es' ? 'lang-es-btn px-3 py-1 rounded-full font-mono text-label-sm bg-azul-noche text-white transition-colors' : 'lang-es-btn px-3 py-1 rounded-full font-mono text-label-sm text-azul-noche/70 hover:text-azul-noche transition-colors'; });
      document.querySelectorAll('.lang-en-btn').forEach((b) => { b.className = lang === 'en' ? 'lang-en-btn px-3 py-1 rounded-full font-mono text-label-sm bg-azul-noche text-white transition-colors' : 'lang-en-btn px-3 py-1 rounded-full font-mono text-label-sm text-azul-noche/70 hover:text-azul-noche transition-colors'; });
    }
    function openModal(title) {
      mascotSay('COSMO · REGISTRO', '¡Genial! En «' + (title || 'esta sesión') + '» te llevás una ficha práctica para el aula.', 'excited');
      const m = document.getElementById('action-modal');
      document.getElementById('modal-heading').textContent = title || 'Inscripción a actividad';
      document.getElementById('modal-form').classList.remove('hidden');
      document.getElementById('modal-receipt').classList.add('hidden');
      m.classList.remove('hidden'); m.classList.add('flex');
    }
    function closeModal() { const m = document.getElementById('action-modal'); m.classList.add('hidden'); m.classList.remove('flex'); }
    function submitQuickForm(e) {
      mascotSay('COSMO · ¡LISTO!', '¡Plaza confirmada! Anotá una pregunta para debatir con el equipo HERC.', 'proud'); e.preventDefault(); document.getElementById('modal-form').classList.add('hidden'); document.getElementById('modal-receipt').classList.remove('hidden'); }
    function openShareModal() {
      mascotSay('COSMO · APORTE', 'Podés compartir cómo adaptaste una charla o experimento en tu curso.', 'thinking');
      const m = document.getElementById('share-modal');
      document.getElementById('share-form').classList.remove('hidden');
      document.getElementById('share-receipt').classList.add('hidden');
      m.classList.remove('hidden'); m.classList.add('flex');
    }
    function closeShareModal() { const m = document.getElementById('share-modal'); m.classList.add('hidden'); m.classList.remove('flex'); }
    function submitShareForm(e) { e.preventDefault(); document.getElementById('share-form').classList.add('hidden'); document.getElementById('share-receipt').classList.remove('hidden'); }

    (function syncHeaderStella(){
      try {
        const raw = localStorage.getItem('cba_stella_profile_v1');
        if (raw) {
          const p = JSON.parse(raw);
          document.querySelectorAll('.header-stella-val').forEach((el) => { el.textContent = p.stellas ?? 250; });
        }
      } catch (e) {}
    })();
  </script>


