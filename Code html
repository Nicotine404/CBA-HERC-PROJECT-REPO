  <script>
    const STORAGE_KEY = 'cba_stella_profile_v1';
    function loadProfile() {
      try { const raw = localStorage.getItem(STORAGE_KEY); if (raw) return JSON.parse(raw); } catch (e) {}
      return { name: 'Explorador STEM', email: '', school: 'Santa Cruz', avatar: 'mascot', stellas: 250, solved: [], redeemed: [] };
    }
    function saveProfile(p) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(p)); } catch (e) {}
      const el = document.getElementById('header-stella-balance');
      if (el) el.textContent = p.stellas;
    }
    let profile = loadProfile();
    saveProfile(profile);

    const cosmoFaces = {
      happy: { label: 'Feliz', svg: '<path d="M33 38 L38 33 L43 38" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M57 38 L62 33 L67 38" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M43 45 Q50 51 57 45" fill="none" stroke="#FDBA74" stroke-width="2.5" stroke-linecap="round"/>' },
