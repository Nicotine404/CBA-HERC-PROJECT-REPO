  <script>
    const STORAGE_KEY = 'cba_stella_profile_v1';
    function loadProfile() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) return JSON.parse(raw);
      } catch (e) {}
      return { name: 'Explorador STEM', email: '', school: 'Santa Cruz', avatar: 'mascot', stellas: 250, solved: [], redeemed: [] };
    }
    function saveProfile(p) {
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(p)); } catch (e) {}
      const el = document.getElementById('header-stella-balance');
      if (el) el.textContent = p.stellas;
    }

    const challenges = [
      {
        id: 'hohmann', reward: 250,
        meta: 'RETO 01 · ASTRODINÁMICA · +250 STELLA',
        title: 'Órbita de Transferencia Hohmann a Marte',
        prompt: 'Una sonda parte de la Tierra (r₁ = 1.00 UA) hacia Marte (r₂ = 1.52 UA) usando una órbita elíptica de Hohmann con semieje mayor a = 1.26 UA. Según la Tercera Ley de Kepler (T² = a³ en años), ¿cuántos días terrestres (entero más cercano, 1 año = 365.25 días) tarda el viaje de ida (T / 2)?',
        hint: 'Calculá √(1.26³) años para el período completo T, dividilo entre 2 y multiplicá por 365.25.',
        answers: ['258', '259']
      },
      {
        id: 'autonav', reward: 350,
        meta: 'RETO 02 · ROBÓTICA AUTONAV · +350 STELLA',
        title: 'Costo Mínimo de Ruta en Terreno Marciano',
        prompt: 'El rover Perseverance debe ir de (0,0) a (2,2) en una cuadrícula de costos: fila 0 = [1, 4, 9], fila 1 = [2, 3, 2], fila 2 = [8, 5, 4]. Solo puede moverse a la derecha o hacia abajo. ¿Cuál es el costo mínimo total de energía incluyendo la celda inicial y final?',
        hint: 'Probá la ruta (0,0) → (1,0) → (1,1) → (1,2) → (2,2) y sumá los 5 valores.',
        answers: ['12']
      },
      {
        id: 'gears', reward: 400,
        meta: 'RETO 03 · MECÁNICA HERC · +400 STELLA',
        title: 'Relación de Torque en 3 Etapas',
        prompt: 'La transmisión del rover HERC tiene 3 etapas en serie: Etapa 1 (12 dientes → 36 dientes), Etapa 2 (15 dientes → 45 dientes) y Etapa 3 (10 dientes → 20 dientes). ¿Cuál es la relación total de reducción de torque (N : 1)? Escribí solo el número N.',
        hint: 'Multiplicá la relación de cada etapa: (36/12) × (45/15) × (20/10).',
        answers: ['18']
      },
      {
        id: 'cipher', reward: 500,
        meta: 'RETO 04 · CRIPTOGRAFÍA LUNAR · +500 STELLA',
        title: 'Decodificar Telemetría con Desplazamiento César',
        prompt: 'La estación lunar envió el mensaje cifrado «URYHU KHUF» usando un desplazamiento César de +3 letras en el alfabeto inglés (A→D, B→E...). ¿Cuál es el mensaje original en mayúsculas (dos palabras)?',
        hint: 'Retrocedé 3 letras por cada carácter: U − 3 = R, R − 3 = O...',
        answers: ['ROVER HERC']
      }
    ];

    let activeIdx = 0;
    let profile = loadProfile();
    saveProfile(profile);

    const cosmoFaces = {
      happy: { label: 'Feliz', svg: '<path d="M33 38 L38 33 L43 38" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M57 38 L62 33 L67 38" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/><path d="M43 45 Q50 51 57 45" fill="none" stroke="#FDBA74" stroke-width="2.5" stroke-linecap="round"/>' },
      excited: { label: 'Emocionado', svg: '<polygon points="38,30 40,35 45,35 41,38 42,43 38,40 34,43 35,38 31,35 36,35" fill="#FCD34D"/><polygon points="62,30 64,35 69,35 65,38 66,43 62,40 58,43 59,38 55,35 60,35" fill="#FCD34D"/><path d="M42 45 Q50 53 58 45 Z" fill="#FE6F3F"/>' },
      thinking: { label: 'Curioso', svg: '<circle cx="38" cy="36" r="4.5" fill="none" stroke="#FFFFFF" stroke-width="2.5"/><circle cx="62" cy="34" r="3" fill="#FFFFFF"/><path d="M44 46 Q50 44 56 47" fill="none" stroke="#93C5FD" stroke-width="2.5" stroke-linecap="round"/><text x="68" y="30" fill="#FCD34D" font-size="10" font-family="monospace" font-weight="bold">?</text>' },
      surprised: { label: 'Asombrado', svg: '<path d="M32 37 L37 32 L42 37 L37 42 Z" fill="none" stroke="#FFFFFF" stroke-width="2.5"/><path d="M58 37 L63 32 L68 37 L63 42 Z" fill="none" stroke="#FFFFFF" stroke-width="2.5"/><circle cx="50" cy="47" r="3" fill="#FDBA74"/>' },
      proud: { label: 'Orgulloso', svg: '<rect x="31" y="33" width="16" height="9" rx="2.5" fill="#38BDF8" stroke="#FFFFFF" stroke-width="1.8"/><rect x="53" y="33" width="16" height="9" rx="2.5" fill="#38BDF8" stroke="#FFFFFF" stroke-width="1.8"/><line x1="47" y1="37" x2="53" y2="37" stroke="#FFFFFF" stroke-width="2"/><path d="M43 46 Q50 50 57 45" fill="none" stroke="#FCD34D" stroke-width="2.5" stroke-linecap="round"/>' },
      encouraging: { label: 'Ánimo', svg: '<circle cx="38" cy="37" r="3.5" fill="#FFFFFF"/><circle cx="62" cy="37" r="3.5" fill="#FFFFFF"/><path d="M44 46 Q50 49 56 46" fill="none" stroke="#6EE7B7" stroke-width="2.5" stroke-linecap="round"/>' }
    };

    const mascotTips = [
      ['COSMO · RETO STEM', '¡Soy Cosmo! Cada reto resuelto te suma monedas Stella en tu cuenta.', 'thinking'],
      ['COSMO · CONSEJO', 'Si te trabás, tocá «Pista» para ver una guía sin perder puntos.', 'encouraging'],
      ['COSMO · DATO', 'Con 1,000 Stella podés canjear una mención en nuestra historia oficial.', 'excited']
    ];
    let mascotIdx = 0;
    function mascotSay(tag, text, mood) {
      const f = cosmoFaces[mood] || cosmoFaces.happy;
      document.getElementById('mascot-tag').textContent = tag;
      document.getElementById('mascot-text').textContent = text;
      const pEl = document.getElementById('mascot-mood-pill');
      const faceEl = document.getElementById('cosmo-face');
      if (pEl) pEl.textContent = f.label;
      if (faceEl) faceEl.innerHTML = f.svg;
    }
    function nextMascotTip() {
      mascotIdx = (mascotIdx + 1) % mascotTips.length;
      mascotSay(mascotTips[mascotIdx][0], mascotTips[mascotIdx][1], mascotTips[mascotIdx][2]);
    }
    mascotSay(mascotTips[0][0], mascotTips[0][1], mascotTips[0][2]);

    function selectChallenge(idx, btn) {
      activeIdx = idx;
      const c = challenges[idx];
      document.getElementById('chal-meta').textContent = c.meta;
      document.getElementById('chal-title').textContent = c.title;
      document.getElementById('chal-prompt').textContent = c.prompt;
      document.getElementById('chal-hint-box').classList.add('hidden');
      document.getElementById('chal-answer').value = '';
      const solved = profile.solved.includes(c.id);
      document.getElementById('chal-status').textContent = solved ? 'Resuelto ✓' : 'Pendiente';
      document.querySelectorAll('.chal-btn').forEach((b) => {
        b.className = 'chal-btn text-left p-4 rounded-xl bg-warm-card text-azul-noche border border-warm-border hover:border-azul-noche flex items-center justify-between gap-3 transition-colors';
      });
      if (btn) btn.className = 'chal-btn text-left p-4 rounded-xl bg-azul-noche text-white border border-azul-noche flex items-center justify-between gap-3 transition-colors';
      mascotSay('COSMO · RETO ' + (idx + 1), solved ? '¡Ya dominaste este reto! Probá otro para sumar más Stella.' : 'Este reto vale +' + c.reward + ' Stella. ¡Vos podés!', solved ? 'proud' : 'thinking');
    }

    function toggleHint() {
      const box = document.getElementById('chal-hint-box');
      box.textContent = 'Pista: ' + challenges[activeIdx].hint;
      box.classList.toggle('hidden');
      mascotSay('COSMO · PISTA', 'Usá la pista paso a paso y verificá tus unidades.', 'encouraging');
    }

    function submitChallenge(e) {
      e.preventDefault();
      const c = challenges[activeIdx];
      const val = document.getElementById('chal-answer').value.trim().toUpperCase();
      if (c.answers.includes(val)) {
        if (!profile.solved.includes(c.id)) {
          profile.solved.push(c.id);
          profile.stellas += c.reward;
          saveProfile(profile);
          document.getElementById('chal-status').textContent = 'Resuelto ✓';
          mascotSay('COSMO · ¡CORRECTO!', '¡Ganaste +' + c.reward + ' Stella! Ya tenés ' + profile.stellas + ' Stella.', 'excited');
        } else {
          mascotSay('COSMO · YA RESUELTO', 'Respuesta correcta, aunque ya cobraste las Stella de este reto.', 'proud');
        }
      } else {
        mascotSay('COSMO · CASI...', 'Ese valor no coincide. Revisá el cálculo o tocá «Pista».', 'encouraging');
      }
    }
  </script>


