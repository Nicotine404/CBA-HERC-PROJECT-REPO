      proud: { label: 'Orgulloso', svg: '<rect x="31" y="33" width="16" height="9" rx="2.5" fill="#38BDF8" stroke="#FFFFFF" stroke-width="1.8"/><rect x="53" y="33" width="16" height="9" rx="2.5" fill="#38BDF8" stroke="#FFFFFF" stroke-width="1.8"/><line x1="47" y1="37" x2="53" y2="37" stroke="#FFFFFF" stroke-width="2"/><path d="M43 46 Q50 50 57 45" fill="none" stroke="#FCD34D" stroke-width="2.5" stroke-linecap="round"/>' },
      encouraging: { label: 'Ánimo', svg: '<circle cx="38" cy="37" r="3.5" fill="#FFFFFF"/><circle cx="62" cy="37" r="3.5" fill="#FFFFFF"/><path d="M44 46 Q50 49 56 46" fill="none" stroke="#6EE7B7" stroke-width="2.5" stroke-linecap="round"/>' }
    };

    const mascotTips = [
      ['COSMO · CUENTA', '¡Soy Cosmo! Elegí tu foto y guardá tu correo para proteger tus Stella.', 'happy'],
      ['COSMO · DATO', 'Tu saldo de Stella se sincroniza entre Retos, Tienda y Cuenta.', 'surprised'],
      ['COSMO · META', 'Con 1,000 Stella ya podés canjear tu mención en la historia oficial.', 'excited']
    ];
    let mascotIdx = 0;
    function mascotSay(tag, text, mood) {
      const f = cosmoFaces[mood] || cosmoFaces.happy;
      document.getElementById('mascot-tag').textContent = tag;
      document.getElementById('mascot-text').textContent = text;
      const pEl = document.getElementById('mascot-mood-pill');
      const faceEl = document.getElementById('cosmo-face');
      if (pEl) pEl.textContent = f.label;
      if (faceEl) faceEl.innerHTML = f.svg;
    }
    function nextMascotTip() {
      mascotIdx = (mascotIdx + 1) % mascotTips.length;
      mascotSay(mascotTips[mascotIdx][0], mascotTips[mascotIdx][1], mascotTips[mascotIdx][2]);
    }
    mascotSay(mascotTips[0][0], mascotTips[0][1], mascotTips[0][2]);

    function pickAvatar(src) {
      profile.avatar = src;
      saveProfile(profile);
      syncUI();
      mascotSay('COSMO · ¡BUEN LOOK!', '¡Me encanta! Actualizaste tu foto de perfil.', 'proud');
    }
    function uploadAvatar(e) {
      const file = e.target.files && e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = () => {
        profile.avatar = reader.result;
        saveProfile(profile);
        syncUI();
        mascotSay('COSMO · FOTO SUBIDA', '¡Tu foto personalizada ya está guardada en tu cuenta!', 'excited');
      };
      reader.readAsDataURL(file);
    }
    function saveAccountForm(e) {
      e.preventDefault();
      profile.name = document.getElementById('acc-name').value.trim();
      profile.email = document.getElementById('acc-email').value.trim();
      profile.school = document.getElementById('acc-school').value.trim();
      saveProfile(profile);
      syncUI();
      mascotSay('COSMO · ¡GUARDADO!', 'Perfil y ' + profile.stellas + ' Stella guardados con éxito.', 'proud');
    }
  </script>


