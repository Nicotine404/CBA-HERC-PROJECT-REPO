    const cosmoTips = [
      ['COSMO · ¡HOLA!', '¡Hola! Soy Cosmo, tu copiloto en CBA Science. Tocá cualquier planeta para explorar o el Sol HUB para ver todas las secciones.', 'happy'],
      ['COSMO · MISIÓN', 'Me encanta la ingeniería espacial y ayudarte a resolver retos difíciles para ganar monedas Stella.', 'excited'],
      ['COSMO · DATO', 'Cada planeta orbita a su propia velocidad, ¡y podés agrandar las galaxias de las esquinas pasando el mouse!', 'surprised'],
