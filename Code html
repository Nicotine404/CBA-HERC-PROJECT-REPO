        if (!menu.classList.contains('hidden')) {
          cosmoSay('COSMO · MAPA', '¡Genial! Elegí cualquier sección del menú HUB, incluso Retos, Tienda o Cuenta.', 'excited');
        } else {
          cosmoSay('COSMO · ÓRBITA', 'Podés hacer clic en cualquier planeta en movimiento cuando quieras.', 'happy');
        }
